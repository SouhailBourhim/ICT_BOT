# Ingestion-specific environment configuration
# Optimized for high-memory document processing

# Model Configuration
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://ollama-ingestion:11434
EMBEDDING_MODEL=llama3
MAX_TOKENS=4096
TEMPERATURE=0.1

# Database Paths (container paths)
CHROMA_PATH=/app/chroma
METADATA_DB_PATH=/app/data/metadata.db
CONVERSATION_DB_PATH=/app/data/conversations.db
ANALYTICS_DB_PATH=/app/data/analytics.db

# Retrieval Configuration
DEFAULT_K=5
MAX_K=20
SIMILARITY_THRESHOLD=0.7
HYBRID_ALPHA=0.5
RERANK_TOP_K=10

# Processing Configuration (Memory optimized)
MIN_CHUNK_SIZE=400
MAX_CHUNK_SIZE=1500
CHUNK_OVERLAP=150
BATCH_SIZE=3  # Smaller batches for memory efficiency

# Conversation Configuration
MAX_CONTEXT_TOKENS=2000
CONTEXT_WINDOW_MESSAGES=10
CONVERSATION_TIMEOUT_HOURS=24
ENABLE_SUMMARIZATION=false  # Disable during ingestion

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=/app/logs/ingestion.log
MAX_LOG_SIZE_MB=500
BACKUP_COUNT=10
ENABLE_STRUCTURED_LOGGING=true

# Performance Configuration (Memory optimized)
ENABLE_CACHING=false  # Disable caching during ingestion
CACHE_TTL_SECONDS=3600
MAX_CONCURRENT_REQUESTS=2  # Limit concurrency
REQUEST_TIMEOUT_SECONDS=300  # Longer timeout for processing
ENABLE_METRICS=true

# UI Configuration (Not used during ingestion)
PAGE_TITLE=RAG Ingestion System
PAGE_ICON=📚
ENABLE_AUTO_COMPLETE=false
MAX_RESPONSE_LENGTH=5000
ENABLE_CITATIONS=true

# Ingestion-specific settings
INGESTION_MODE=true
EXPORT_PATH=/app/export